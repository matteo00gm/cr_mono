                    "type": "object",
                    "properties": {
                      "invitationId": {
                        "type": "string"
                      },
                      "revoked": {
                        "type": "boolean",
                        "const": true
                      }
                    },
                    "required": [
                      "invitationId",
                      "revoked"
                    ],
                    "additionalProperties": false
                  },
                  "example": {
                    "invitationId": "4f1c9a2e-77b8-4a6d-9c31-2e77b84a6d9c",
                    "revoked": true
                  }
                }
              }
            },
            "401": {
              "description": "The request failed. `code` is stable; `message` is for a human.",
              "content": {
                "application/json": {
