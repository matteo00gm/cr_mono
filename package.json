{
  "name": "catalogorosso",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI Sommelier — Multi-Tenant SaaS RAG Platform",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run build && vitest run",
    "test:watch": "turbo run build && vitest",
    "test:coverage": "turbo run build && vitest run --coverage",
    "test:integration": "turbo run build && vitest run --config vitest.integration.config.ts",
    "coverage:check": "node scripts/check-coverage.mjs",
    "audit:check": "node scripts/check-audit.mjs",
    "boundaries": "depcruise apps packages",
    "lint": "turbo run lint",
    "lint:root": "eslint . --ignore-pattern \"apps/**\" --ignore-pattern \"packages/**\"",
    "typecheck": "turbo run typecheck",
    "typecheck:infra": "node scripts/check-infra-types.mjs",
    "typecheck:infra-pure": "node scripts/check-infra-pure-types.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf --glob coverage .turbo \"{apps,packages}/*/dist\" \"{apps,packages}/*/.turbo\" \"{apps,packages}/*/*.tsbuildinfo\"",
    "db:generate": "drizzle-kit generate",
    "prepare": "husky",
    "db:seed": "node scripts/db-seed.mjs",
    "adr:check": "node scripts/check-adrs.mjs",
    "agents:check": "node scripts/check-agents-md.mjs",
    "changelog": "node scripts/changelog.mjs",
    "openapi": "node scripts/gen-openapi.mjs",
    "openapi:check": "node scripts/gen-openapi.mjs --check",
    "consumers": "node scripts/api-consumers.mjs",
    "consumers:check": "node scripts/api-consumers.mjs --check"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^17.4.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "postgres": "^3.4.9",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sst": "^4.17.1",
    "turbo": "^2.10.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
