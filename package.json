{
  "name": "catalogorosso",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI Sommelier — Multi-Tenant SaaS RAG Platform",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf --glob coverage .turbo \"{apps,packages}/*/dist\" \"{apps,packages}/*/.turbo\" \"{apps,packages}/*/*.tsbuildinfo\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
