{
  "name": "@catalogorosso/core",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./completeness": {
      "types": "./dist/completeness.d.ts",
      "default": "./dist/completeness.js"
    },
    "./inline-edit": {
      "types": "./dist/inline-edit.d.ts",
      "default": "./dist/inline-edit.js"
    },
    "./import-limits": {
      "types": "./dist/import-limits.d.ts",
      "default": "./dist/import-limits.js"
    },
    "./variant-id": {
      "types": "./dist/shopify/variant-id.d.ts",
      "default": "./dist/shopify/variant-id.js"
    },
    "./contrast": {
      "types": "./dist/a11y/contrast.d.ts",
      "default": "./dist/a11y/contrast.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@catalogorosso/db": "workspace:*",
    "@catalogorosso/security": "workspace:*",
    "better-auth": "^1.7.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  }
}
