{
  "name": "@catalogorosso/security",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/keys.d.ts",
      "default": "./dist/tokens/keys.js"
    },
    "./net": {
      "types": "./dist/net/index.d.ts",
      "default": "./dist/net/index.js"
    },
    "./api-keys": {
      "types": "./dist/api-keys.d.ts",
      "default": "./dist/api-keys.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@catalogorosso/testing": "workspace:*"
  },
  "dependencies": {
    "jose": "6.2.12",
    "tldts": "7.4.11"
  }
}
