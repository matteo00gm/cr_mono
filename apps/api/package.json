{
  "name": "@catalogorosso/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.883.0",
    "@catalogorosso/api-client": "workspace:*",
    "@catalogorosso/core": "workspace:*",
    "@catalogorosso/llm": "workspace:*",
    "@catalogorosso/security": "workspace:*",
    "hono": "^4.13.5",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@catalogorosso/db": "workspace:*",
    "@catalogorosso/testing": "workspace:*",
    "@types/node": "^26.4.0",
    "drizzle-orm": "^0.45.2"
  },
  "type": "module",
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./security-events": {
      "types": "./dist/security-events.d.ts",
      "default": "./dist/security-events.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "default": "./dist/chat.js"
    },
    "./quota": {
      "types": "./dist/quota.d.ts",
      "default": "./dist/quota.js"
    },
    "./dev-billing": {
      "types": "./dist/dev-billing.d.ts",
      "default": "./dist/dev-billing.js"
    },
    "./stripe-events": {
      "types": "./dist/stripe-events.d.ts",
      "default": "./dist/stripe-events.js"
    },
    "./billing-events": {
      "types": "./dist/billing-events.d.ts",
      "default": "./dist/billing-events.js"
    }
  }
}
