{
  "extends": "../../tsconfig.base.json",
  /* Lint + typecheck project: sees tests, emits nothing. */
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    /* Browser-side app: the base config ships ES-only libs. */
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "test"]
}
