# Formatting and lint on staged files.
npx lint-staged

# Secret scan on staged changes.
#
# This is the control that actually matters. Once a secret reaches a pushed
# commit it is in the history permanently and rotation is mandatory — the CI
# scan runs after the push, so it can only tell you that you already have an
# incident.
#
# A missing scanner is a hard failure, not a skip. A hook that quietly passes
# when its tool is absent is worse than no hook: it reports a safety property
# it never checked.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo ""
  echo "  gitleaks is not installed, so staged changes were not scanned for secrets."
  echo ""
  echo "    winget install Gitleaks.Gitleaks   (Windows)"
  echo "    brew install gitleaks              (macOS)"
  echo "    https://github.com/gitleaks/gitleaks/releases"
  echo ""
  echo "  Pin note: CI uses 8.30.1; winget currently serves the same version."
  echo ""
  echo "  In a genuine emergency, 'git commit --no-verify' bypasses this hook."
  echo "  CI scans full history regardless, so anything pushed that way is still"
  echo "  caught — just after the secret is already unrecoverable."
  echo ""
  exit 1
fi

# --redact keeps the secret out of terminal scrollback and shell history.
gitleaks git --staged --redact --no-banner
